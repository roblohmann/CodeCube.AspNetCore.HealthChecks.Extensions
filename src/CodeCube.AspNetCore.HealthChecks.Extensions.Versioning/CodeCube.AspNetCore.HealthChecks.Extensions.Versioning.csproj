<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<VersionPrefix>8.0.10</VersionPrefix>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>Rob Lohmann</Authors>
		<Copyright>2020 - 2026</Copyright>
		<PackageIcon>nuget-icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/roblohmann/CodeCube.AspNetCore.HealthChecks.Extensions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/roblohmann/CodeCube.AspNetCore.HealthChecks.Extensions</RepositoryUrl>
		<PackageTags>aspnetcore healthcheck versionnumber</PackageTags>
		<Description>Library with extensions on the Microsoft.Extensions.Diagnostics.HealthCheck library to add a versionnumber to the raw output of the healthcheck</Description>
	</PropertyGroup>
	
	<ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="CodeCube.AspNetCore.HealthChecks.Extensions.Response" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net7.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="CodeCube.AspNetCore.HealthChecks.Extensions.Response" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="CodeCube.AspNetCore.HealthChecks.Extensions.Response" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="CodeCube.AspNetCore.HealthChecks.Extensions.Response" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="CodeCube.AspNetCore.HealthChecks.Extensions.Response" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>
	
  <ItemGroup>
    <None Include="../../nuget-icon.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

</Project>
